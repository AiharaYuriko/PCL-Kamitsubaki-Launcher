<local:MyPageRight x:Class="PageInstancePackPublish"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard x:Name="PublishCard" Title="整合包发布" Margin="0,15,0,15">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="请先用原始客户端整合包建立基线，再修改此实例。可以扫描目录，也可以导入指定文件；只用指定文件时请清空扫描目录。" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <UniformGrid Columns="2">
                        <local:MyTextBox x:Name="PackName" HintText="整合包显示名称" Margin="0,0,6,6" Height="32" />
                        <local:MyTextBox x:Name="PackId" HintText="整合包 ID（例 kamitsubaki-city）" Margin="0,0,0,6" Height="32" />
                        <local:MyTextBox x:Name="PublishReleaseId" HintText="发布 ID（例 2026-11-01）" Margin="0,0,6,6" Height="32" />
                        <local:MyTextBox x:Name="PublishChannel" HintText="频道（默认 stable）" Margin="0,0,0,6" Height="32" />
                    </UniformGrid>
                    <local:MyTextBox x:Name="PublishNotes" HintText="发布说明" Margin="0,0,0,6" MinHeight="32" AcceptsReturn="True" TextWrapping="Wrap" />
                    <local:MyTextBox x:Name="PublishFolders" HintText="扫描目录，每行一个或用分号分隔" Margin="0,0,0,6" MinHeight="45" AcceptsReturn="True" TextWrapping="Wrap" />
                    <local:MyTextBox x:Name="PublishFilePaths" HintText="指定文件（实例内相对路径，每行一个）" Margin="0,0,0,6" MinHeight="32" MaxHeight="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <WrapPanel Margin="0,4,0,8">
                        <local:MyButton x:Name="PublishScan" Text="扫描并预览" Height="34" MinWidth="110" Margin="0,0,8,4" />
                        <local:MyButton x:Name="PublishImportFiles" Text="导入指定文件" Height="34" MinWidth="110" Margin="0,0,8,4" />
                        <local:MyButton x:Name="PublishBaseline" Text="保存旧包基线" Height="34" MinWidth="110" Margin="0,0,8,4" />
                        <local:MyButton x:Name="PublishMaps" Text="导入 Xaero 地图" Height="34" MinWidth="125" Margin="0,0,8,4" />
                        <local:MyButton x:Name="PublishWaypoints" Text="导入 Xaero 航点" Height="34" MinWidth="125" Margin="0,0,8,4" />
                        <local:MyButton x:Name="PublishSelectZip" Text="确认全部 Mod 可公开分发" Height="34" MinWidth="185" Margin="0,0,8,4" />
                    </WrapPanel>
                    <DataGrid x:Name="PublishFiles" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="395" MinHeight="100"
                              EnableRowVirtualization="True" RowHeaderWidth="0" SelectionMode="Single" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件" Binding="{Binding Path}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="变化" Binding="{Binding Change}" Width="62" IsReadOnly="True" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Platform}" Width="82" IsReadOnly="True" />
                            <DataGridComboBoxColumn x:Name="PublishOperations" Header="发布策略" SelectedItemBinding="{Binding Operation}" Width="132" />
                            <DataGridCheckBoxColumn Header="ZIP 备用" Binding="{Binding EmbedMod}" Width="65" />
                            <DataGridCheckBoxColumn Header="可选" Binding="{Binding Optional}" Width="44" />
                            <DataGridTextColumn Header="JSON Pointer（分号分隔）" Binding="{Binding JsonKeys}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="公开 R2 地址与发布凭据" Margin="0,4,0,6" />
                    <UniformGrid Columns="2">
                        <local:MyTextBox x:Name="PublishAccount" HintText="R2 Account ID" Margin="0,0,6,6" Height="32" />
                        <local:MyTextBox x:Name="PublishBucket" HintText="R2 存储桶名称" Margin="0,0,0,6" Height="32" />
                        <local:MyTextBox x:Name="PublishRoot" HintText="https://下载域名/桶内目录（目录可省略）" Margin="0,0,6,6" Height="32" />
                        <local:MyTextBox x:Name="PublishAccess" HintText="R2 Access Key ID" Margin="0,0,0,6" Height="32" />
                        <TextBlock Text="R2 Secret Access Key" VerticalAlignment="Center" />
                        <PasswordBox x:Name="PublishSecret" Margin="0,0,0,6" Height="32" VerticalContentAlignment="Center" />
                    </UniformGrid>
                    <local:MyCheckBox x:Name="PublishMirror" Text="发布后同步到备用 S3（OSCA）" Margin="0,12,0,6" />
                    <UniformGrid x:Name="PublishMirrorCredentials" Columns="2">
                        <StackPanel Margin="0,0,6,6">
                            <TextBlock Text="备用 S3 存储桶" Margin="0,0,0,4" />
                            <local:MyTextBox x:Name="PublishMirrorBucket" AutomationProperties.Name="备用 S3 存储桶" Height="32" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="备用签名服务地址" Margin="0,0,0,4" />
                            <local:MyTextBox x:Name="PublishMirrorRoot" AutomationProperties.Name="备用签名服务地址" Height="32" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,6">
                            <TextBlock Text="备用 S3 Access Key ID" Margin="0,0,0,4" />
                            <local:MyTextBox x:Name="PublishMirrorAccess" AutomationProperties.Name="备用 S3 Access Key ID" Height="32" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="备用 S3 Secret Access Key" Margin="0,0,0,4" />
                            <PasswordBox x:Name="PublishMirrorSecret" AutomationProperties.Name="备用 S3 Secret Access Key" Height="32" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel Margin="0,2,0,8">
                        <local:MyCheckBox x:Name="PublishRemember" Text="为当前 Windows 用户保存凭据" Margin="0,0,14,6" />
                        <local:MyCheckBox x:Name="PublishDowngrade" Text="允许 NeoForge 降级" Margin="0,0,0,6" />
                    </WrapPanel>
                    <WrapPanel>
                        <local:MyButton x:Name="PublishNow" Text="正式发布" ColorType="Highlight" Height="35" MinWidth="120" Margin="0,0,8,5" />
                        <local:MyButton x:Name="PublishCopy" Text="复制更新源" Height="35" MinWidth="110" Margin="0,0,8,5" />
                        <local:MyButton x:Name="PublishExport" Text="导出测试 ZIP" Height="35" MinWidth="110" Margin="0,0,0,5" />
                    </WrapPanel>
                    <TextBlock x:Name="PublishStatus" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
