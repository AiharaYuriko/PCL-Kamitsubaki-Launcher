<local:MyPageRight x:Class="PageInstancePackUpdate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyCard Title="更新源" Margin="0,15,0,15">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="粘贴服主提供的地址，即可检查此实例的整合包更新。" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <local:MyTextBox x:Name="Source" HintText="https://下载域名/桶内目录" Margin="0,0,0,12" Height="35" VerticalContentAlignment="Center" />
                    <local:MyTextBox x:Name="MirrorSource" HintText="S3 备用线路签名服务地址（可选）" Margin="0,0,0,8" Height="35" VerticalContentAlignment="Center" />
                    <local:MyCheckBox x:Name="PreferMirror" Text="优先使用 S3 备用线路" Margin="0,0,0,12" />
                    <local:MyComboBox x:Name="Choices" Height="30" Margin="0,0,0,12" />
                    <WrapPanel>
                        <local:MyButton x:Name="ReadSource" Text="读取更新源" Width="120" Height="35" Margin="0,0,12,0" />
                        <local:MyButton x:Name="ResetSource" Text="恢复默认更新源" Width="140" Height="35" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="检查与更新" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,20">
                    <WrapPanel x:Name="Components" />
                    <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,4,0,15" />
                    <ProgressBar x:Name="Bar" Height="3" Margin="0,0,0,15" />
                    <WrapPanel x:Name="DownloadActions" Visibility="Collapsed" Margin="0,0,0,10">
                        <local:MyButton x:Name="SwitchRoute" Text="换线路" Height="32" MinWidth="95" Margin="0,0,12,0"
                                        ToolTip="跳过当前下载，尝试下一条可用线路" />
                        <local:MyButton x:Name="CancelUpdate" Text="取消更新" Height="32" MinWidth="95"
                                        ToolTip="停止本次更新，已校验的整合包文件可供下次重试" />
                    </WrapPanel>
                    <WrapPanel>
                        <local:MyButton x:Name="Update" Text="更新整合包" ColorType="Highlight" Height="35" MinWidth="140" Margin="0,0,15,0" IsEnabled="False" />
                        <local:MyButton x:Name="Check" Text="重新检查" Height="35" MinWidth="120" Margin="0,0,15,0" />
                        <local:MyButton x:Name="Restore" Text="恢复上次更新" Height="35" MinWidth="140" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="文件变化" Margin="0,0,0,15">
                <StackPanel x:Name="Details" Margin="15,40,15,15" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
